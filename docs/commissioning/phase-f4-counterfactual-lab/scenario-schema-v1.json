{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase-f4-counterfactual-scenario-v1",
  "title": "CounterfactualScenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "scenario_version", "deterministic_seed", "backend", "target_domain", "initial_state_fingerprint", "mutations", "assertions", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": "counterfactual-scenario-v1"},
    "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,95}$"},
    "scenario_version": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,95}$"},
    "deterministic_seed": {"type": "integer", "minimum": 0},
    "backend": {"enum": ["VENUE_MODEL", "EVM_ANVIL"]},
    "target_domain": {"type": "string", "minLength": 1, "maxLength": 96},
    "target_chain_id": {"type": ["integer", "null"], "minimum": 1},
    "fixed_fork_block": {"type": ["integer", "null"], "minimum": 1},
    "initial_state_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mutations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/verb"}},
    "assertions": {"type": "array", "items": {"$ref": "#/$defs/verb"}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "provenance": {"const": "COUNTERFACTUAL_ONLY"},
    "parent_scenario_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "mutation_delta": {"type": "array", "items": {"$ref": "#/$defs/verb"}}
  },
  "$defs": {
    "verb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb"],
      "properties": {
        "verb": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,95}$"},
        "parameters": {"type": "object"}
      }
    }
  }
}
